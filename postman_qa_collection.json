{
  "info": {
    "name": "Backend Tutorial - Seed and CRUD QA",
    "description": "Creates the three demo books, exercises CRUD and error cases, then leaves only the three demo books in MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "cleanCodeId", "value": "" },
    { "key": "pragmaticId", "value": "" },
    { "key": "javascriptId", "value": "" },
    { "key": "qaTempId", "value": "" }
  ],
  "item": [
    { "name": "00 - Health check", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Health check returns 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/" } },
    { "name": "01 - Create Clean Code", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created with 201', () => pm.response.to.have.status(201));", "const d = pm.response.json();", "pm.test('Returns saved Clean Code record', () => pm.expect(d.book.isbn).to.eql('9780132350884'));", "pm.collectionVariables.set('cleanCodeId', d.book._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"isbn\": \"9780132350884\",\n  \"publishedYear\": 2008,\n  \"available\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books" } },
    { "name": "02 - Create The Pragmatic Programmer", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created with 201', () => pm.response.to.have.status(201));", "const d = pm.response.json();", "pm.test('Returns saved Pragmatic Programmer record', () => pm.expect(d.book.isbn).to.eql('9780135957059'));", "pm.collectionVariables.set('pragmaticId', d.book._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"The Pragmatic Programmer\",\n  \"author\": \"Andrew Hunt and David Thomas\",\n  \"isbn\": \"9780135957059\",\n  \"publishedYear\": 2019,\n  \"available\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books" } },
    { "name": "03 - Create Eloquent JavaScript", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created with 201', () => pm.response.to.have.status(201));", "const d = pm.response.json();", "pm.test('Returns saved Eloquent JavaScript record', () => pm.expect(d.book.isbn).to.eql('9781593279509'));", "pm.collectionVariables.set('javascriptId', d.book._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Eloquent JavaScript\",\n  \"author\": \"Marijn Haverbeke\",\n  \"isbn\": \"9781593279509\",\n  \"publishedYear\": 2018,\n  \"available\": false\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books" } },
    { "name": "04 - List and verify the three seed books", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('List returns 200', () => pm.response.to.have.status(200));", "const books = pm.response.json();", "const isbns = books.map(b => b.isbn);", "pm.test('Exactly three seed books are present', () => pm.expect(books.length).to.eql(3));", "['9780132350884', '9780135957059', '9781593279509'].forEach(isbn => pm.test('Contains ' + isbn, () => pm.expect(isbns).to.include(isbn)));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/books" } },
    { "name": "05 - Create temporary QA book", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created with 201', () => pm.response.to.have.status(201));", "const d = pm.response.json();", "pm.collectionVariables.set('qaTempId', d.book._id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Temporary CRUD QA Record\",\n  \"author\": \"Postman QA\",\n  \"isbn\": \"QA-TEMP-2026-11-03-001\",\n  \"publishedYear\": 2026,\n  \"available\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books" } },
    { "name": "06 - Read temporary QA book by ID", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Read by ID returns 200', () => pm.response.to.have.status(200));", "pm.test('ID matches temporary record', () => pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('qaTempId')));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/books/{{qaTempId}}" } },
    { "name": "07 - Update temporary QA book", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Update returns 200', () => pm.response.to.have.status(200));", "pm.test('Availability changed to false', () => pm.expect(pm.response.json().book.available).to.eql(false));"] } }], "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"available\": false\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books/{{qaTempId}}" } },
    { "name": "08 - Reject invalid book (missing author)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid model data returns 400', () => pm.response.to.have.status(400));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Missing Author\",\n  \"isbn\": \"QA-INVALID-2026-001\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books" } },
    { "name": "09 - Reject duplicate ISBN", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Duplicate ISBN returns 409', () => pm.response.to.have.status(409));"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Duplicate ISBN Check\",\n  \"author\": \"Postman QA\",\n  \"isbn\": \"9780132350884\",\n  \"publishedYear\": 2026,\n  \"available\": true\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/books" } },
    { "name": "10 - Reject malformed ID", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Malformed ID returns 400', () => pm.response.to.have.status(400));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/books/not-a-valid-id" } },
    { "name": "11 - Return 404 for missing valid ID", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing book returns 404', () => pm.response.to.have.status(404));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/books/507f1f77bcf86cd799439011" } },
    { "name": "12 - Delete temporary QA book", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Delete returns 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "DELETE", "url": "{{baseUrl}}/api/books/{{qaTempId}}" } },
    { "name": "13 - Confirm temporary book was deleted", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Deleted book now returns 404', () => pm.response.to.have.status(404));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/books/{{qaTempId}}" } },
    { "name": "14 - Final list contains only three seed books", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Final list returns 200', () => pm.response.to.have.status(200));", "const books = pm.response.json();", "pm.test('Exactly three records remain', () => pm.expect(books.length).to.eql(3));", "pm.test('Temporary QA record is absent', () => pm.expect(books.map(b => b.isbn)).to.not.include('QA-TEMP-2026-11-03-001'));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/books" } }
  ]
}
